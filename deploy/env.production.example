# SD-SIM on the droplet: copy to /opt/sim/.env.production, fill in, chmod 600.
# Never commit the filled-in file. Generate each secret separately:
#   openssl rand -hex 32
# Values must not contain spaces or quotes (the scripts read this file in bash).

# ---- Database: three logins, three different passwords ---------------------
DB_SUPERUSER=sim_admin
DB_SUPERUSER_PASSWORD=          # you only; reads the transaction log
SIM_OWNER_PASSWORD=             # migrations only
SIM_APP_PASSWORD=               # the running app: rows only

# ---- The app ------------------------------------------------------------------
SIM_DOMAIN=sim.straightdrivesport.com
NEXTAUTH_SECRET=                # signs sessions
PASSWORD_ENCRYPTION_KEY=        # its own key for the password vault, NOT derived from NEXTAUTH_SECRET
CRON_SECRET=                    # the daily job's key
BLOB_READ_WRITE_TOKEN=          # Vercel Blob store for invoices (a NEW store for the fresh start)

# ---- Mail (optional: leave empty for in-app notifications only) --------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Backups ----------------------------------------------------------------
# The PUBLIC age key from your own computer (age-keygen); backups are encrypted
# to it and only your private key can open them. Starts with "age1".
BACKUP_AGE_RECIPIENT=
# Optional: also copy each encrypted backup to the bills Space
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
