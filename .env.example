# Copy to .env for local development, or .env.production for a deployment.
# Never commit the filled-in file.

# ---- Required ---------------------------------------------------------------

# PostgreSQL. On Docker Compose the host is the service name, `db`.
#
# Behind a connection pooler (Neon, Supabase, PgBouncer), append
# ?pgbouncer=true&connection_limit=10 — NOT connection_limit=1. Pages here fan
# out many queries inside one request, and a single connection makes them queue
# until Prisma aborts with P2024. See docs/hosting.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/straightdrive?schema=public"

# Signs the session cookie. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# The full public URL, including protocol. Sign-in redirects break without it.
NEXTAUTH_URL="http://localhost:3000"

# ---- Blob storage (any host without a persistent disk, e.g. Vercel) ---------

# Where uploaded documents are stored. src/app/api/upload/route.ts writes to
# Vercel Blob rather than the local filesystem, because a serverless host wipes
# the disk between requests.
#
# On Vercel this variable appears on its own once you create a Blob store and
# connect it to the project — you do not paste it in. Locally, copy it from the
# store's page in the Vercel dashboard if you want uploads to work in `next dev`;
# without it, every other flow still runs and only uploading errors.
BLOB_READ_WRITE_TOKEN=

# Lets NextAuth trust the host header it is served under. Optional on Vercel —
# @auth/core turns trustHost on by itself when it sees the VERCEL variable
# (node_modules/@auth/core/lib/utils/env.js) — but needed behind any other proxy.
#
# The variable that matters more on Vercel is NEXTAUTH_URL above: LEAVE IT OUT.
# When it is set, next-auth rewrites every request's origin to it
# (reqWithEnvURL in node_modules/next-auth/lib/env.js), so a stray
# "http://localhost:3000" copied over from local development sends everyone who
# signs in to their own machine.
AUTH_TRUST_HOST=true

# ---- Docker Compose only ----------------------------------------------------

POSTGRES_USER="sam"
POSTGRES_PASSWORD=""
POSTGRES_DB="straightdrive"
APP_PORT="3000"

# ---- Optional ---------------------------------------------------------------

# The key for the password vault: passwords set through the app are stored
# encrypted as well as hashed, so holders of users.password.view can reveal
# them. When this is empty the key is derived from NEXTAUTH_SECRET instead, so
# the vault is ON either way (src/lib/crypto.ts). Whoever holds the database
# and this key (or NEXTAUTH_SECRET) can read every password set in the app.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_ENCRYPTION_KEY=""

# ---- Mail (optional) ----------------------------------------------------------

# Notifications by mail, sent through Gmail / Google Workspace (or any SMTP
# server). With any of the four SMTP values missing, mail is simply off and
# notifications appear in the app only. For Gmail, SMTP_PASS is an "app
# password" (Google account → Security → 2-Step Verification → App passwords),
# never the mailbox's real password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Optional; defaults to "SD-SIM <SMTP_USER>"
MAIL_FROM=""
# The site's own address, so links in mails open the right page
APP_URL="https://your-app.vercel.app"

# ---- Daily job (optional) ---------------------------------------------------------

# Vercel Cron calls /api/cron/daily every morning (vercel.json) with this as a
# bearer token: it checks low stock and late orders and sends the morning
# summaries. Without it the job refuses to run. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
